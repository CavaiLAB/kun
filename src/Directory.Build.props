<Project>

  <!--
    src/ 下 Kun 包专用的版本、包元数据与 README 打包。
    仓库根的 Directory.Build.props 只放两边共用的基线（S1-KUN-020）；这些设置原来也写在那里，
    挪到这里是为了不让 _import/qian/ 下的包吃到 Kun 包的版本号、元数据与 README。
    公共 API 清单的门禁对全部可打包项目生效，在仓库根的 Directory.Build.targets。
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Versioning">
    <!--
      Resolution precedence:
        1. Explicit -p:Version=… on the command line overrides everything
           (the release tooling derives it from the git tag).
        2. Otherwise VersionPrefix + VersionSuffix compose the SemVer.
        3. CI without an explicit suffix → VersionPrefix only (no local default pollution).
        4. Local dev → VersionPrefix-phase1 so dotnet pack produces nupkgs
           that match the current milestone without the developer remembering a flag.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(CI)' != 'true'">phase1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Package Metadata">
    <Authors>Kun Framework Contributors</Authors>
    <Company>Kun Framework</Company>
    <Product>Kun Framework</Product>
    <Copyright>Copyright © Kun Framework Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CavaiLAB/kun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CavaiLAB/kun.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
