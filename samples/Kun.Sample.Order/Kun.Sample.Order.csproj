<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Kun Framework sample: Order service demonstrating a command flow — place an order, reserve stock over gRPC, publish an integration event through the Outbox.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kun.Sample.Shared\Kun.Sample.Shared.csproj" />
    <ProjectReference Include="..\..\src\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\..\src\Kun.MultiTenancy\Kun.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\src\Kun.Mediator\Kun.Mediator.csproj" />
    <ProjectReference Include="..\..\src\Kun.Validation\Kun.Validation.csproj" />
    <ProjectReference Include="..\..\src\Kun.EventBus.EntityFrameworkCore\Kun.EventBus.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Kun.EntityFrameworkCore\Kun.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Kun.Errors.AspNetCore\Kun.Errors.AspNetCore.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\Kun.Sample.Catalog\Protos\catalog.proto" GrpcServices="Client">
      <Link>Protos\catalog.proto</Link>
    </Protobuf>
  </ItemGroup>
</Project>
