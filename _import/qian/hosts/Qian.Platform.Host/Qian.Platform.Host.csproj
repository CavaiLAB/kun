    <OutputType>Exe</OutputType>
    <!-- 宿主：禁用符号与平台分析器按它接入（仓库根的 Directory.Build.targets，S1-KUN-020）。 -->
    <KunHost>true</KunHost>
    <Description>platform profile 的生产宿主：能力目录、导航、外壳目录、有效权限与平台运营接口。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kun.Data/Kun.Data.csproj" />
