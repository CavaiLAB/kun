<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Qian 数据组件的安全上下文基类与装配错误契约。</Description>
  </PropertyGroup>
  <PropertyGroup Label="档位">
    <KunTier>platform</KunTier>
    <KunRole>contract</KunRole>
  </PropertyGroup>
  <ItemGroup Label="档位例外">
    <KunTierException Include="Kun.EntityFrameworkCore" Rule="D" Until="B5" Reason="已发布的 QianDbContext 继承 KunDbContext，IDataSession 暴露同一上下文的工作单元；B5 EF 部分并入 Kun.EntityFrameworkCore 时去掉" />
    <KunTierException Include="Kun.MultiTenancy.EntityFrameworkCore" Rule="D" Until="B5" Reason="QianDbContext 启动时校验 Kun 的行级安全双拦截器与模型缓存键；B5 三处并成一个 Kun.EntityFrameworkCore 时去掉" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Qian.Runtime/Qian.Runtime.csproj" />
    <ProjectReference Include="../Qian.Config.Abstractions/Qian.Config.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Events.Abstractions/Qian.Events.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Kun.EntityFrameworkCore/Kun.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../../../src/Kun.MultiTenancy.EntityFrameworkCore/Kun.MultiTenancy.EntityFrameworkCore.csproj" />
    <EmbeddedResource Include="../../contracts/v0/event-envelope.schema.json;../../contracts/v0/s2s-claims.schema.json" LogicalName="data/v0/%(Filename)%(Extension)" />
    <None Include="../../contracts/v0/event-envelope.schema.json;../../contracts/v0/s2s-claims.schema.json" Pack="true" PackagePath="contracts/v0/" />
    <EmbeddedResource Include="../../contracts/data/v1/*.json" LogicalName="data/%(Filename)%(Extension)" />
    <None Include="../../contracts/data/v1/*.json" Pack="true" PackagePath="contracts/data/v1/" />
  </ItemGroup>
</Project>
