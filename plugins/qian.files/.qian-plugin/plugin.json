    "metadata": "./metadata",
    "schemas": "./schemas"
  },
  "inject": [
    "Data"
  ],
  "provides": [
    "Files"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false,
    "profiles": [
      "platform",
      "standalone"
    ]
  },
  "scopes": [
    "global",
    "tenant"
