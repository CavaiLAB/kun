// 类型检查专用（pnpm --filter website typecheck）：组件演示引 CavaiLAB/qian 检出里的源码（scripts/qian.ts）。
// @cavailab/qian-* 指到检出的源码；检出与本站各装了一份 @types/react，统一用本站那份，否则同名类型互不兼容。
// 这些映射不能写进 tsconfig.json：Rspress 与演示的 Rsbuild 会把那里的 paths 当打包别名，react 会被解析到声明文件。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@cavailab/qian-*": [
        "./.cache/qian-source/packages/qian/*/src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  }
}
