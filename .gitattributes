# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=crlf

# Configs
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Shell / scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.snk binary
*.pfx binary

# 本仓库加（B2）：以上是原 Kun 的规则。原 Qian 没有 .gitattributes，
# 下一行把这些属性对 _import/qian/ 恢复为未指定；该目录搬空后删掉。
_import/qian/** !text !eol !diff !merge !binary
