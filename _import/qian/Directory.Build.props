<Project>

  <!--
    原 Qian 的 .NET 构建基线（S1-QA-001）。目标框架、质量门槛（可空引用、警告即错误、分析级别、包漏洞审计）
    与确定性构建已并到仓库根的 Directory.Build.props（S1-KUN-020），这里先导入它，只留原 Qian 自己的打包设置。
    「是不是 Qian 包」与 PublicAPI 门禁的判定在 Directory.Build.targets：那里才能看到项目里写的 IsPackable / PackageId。
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Packaging">
    <!--
      默认不打包。Qian 组件包在 csproj 里显式写 <IsPackable>true</IsPackable>，
      随即进入 PublicAPI 门禁（Directory.Build.targets）与依赖图门禁（scripts/check_deps.py）。
    -->
    <IsPackable>false</IsPackable>
    <Authors>Qian Contributors</Authors>
    <Product>Qian</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/idadawn/qian.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
