<Project Sdk="Microsoft.NET.Sdk">

  <!-- 不写 IsAotCompatible：迁移生成器继承 Npgsql 的 EF 迁移 SQL 生成器，所依赖的 Kun.EntityFrameworkCore 也不是 AOT 兼容的。 -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Kun 的 PostgreSQL 迁移 SQL 生成器：建租户表时紧接着打开行级安全并建租户策略。</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.EntityFrameworkCore\Kun.EntityFrameworkCore.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
