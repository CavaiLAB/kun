<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>Kun Framework identity facade: IJwtValidator (external Bearer validation with JWKS), IOidcClient (OIDC discovery + code exchange), and AddKunIdentity fluent DI. Unifies the Authentik/JWT/OIDC configuration that consumer services had been hand-rolling per repo.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.Caching\Kun.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kun.Identity.Tests" />
    <InternalsVisibleTo Include="Kun.Identity.Connector.Oidc" KunPackageFriendReason="OIDC 连接器共用签名算法约束和回调关联校验" />
  </ItemGroup>

</Project>
