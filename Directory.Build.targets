<Project>

  <!--
    仓库的构建守卫与门禁，仓库根与 _import/qian/ 下的项目共用（S1-KUN-020）。_import/qian/Directory.Build.targets 先导入本文件。
    依次是：档位声明、公共 API。
  -->

  <!--
    档位声明（S1-KUN-020；合并蓝图 D23.7、D23.14 第 1 点）。
    可打包的项目必须在项目文件里写档位与角色，依赖门禁 scripts/check_deps.py 按它们检查依赖，不看包名：

      KunTier            kernel（内核档）或 platform（平台档）
      KunRole            contract（契约）或 provider（提供者）
      KunZeroDependency  写 true 的包不得有项目引用，包引用只许 Microsoft.Extensions.*；不写即 false

    依赖规则的例外写成 KunTierException 项，同样在项目文件里，写法见 scripts/check_deps.py。
    这里只查写没写、取值对不对，区分大小写：没写 KunTier 或 KunRole 报 KUNTIER001，取值不对报 KUNTIER002。
    不打包的项目（测试、工具、宿主、样例）不记档位。
  -->
  <Target Name="KunRequireTierDeclaration" BeforeTargets="CoreCompile" Condition="'$(IsPackable)' == 'true'">
    <Error Code="KUNTIER001"
           Condition="'$(KunTier)' == '' or '$(KunRole)' == ''"
           Text="$(MSBuildProjectName) 可打包，项目文件里必须写档位 KunTier（kernel 或 platform）与角色 KunRole（contract 或 provider）。做法见仓库根 AGENTS.md「档位与依赖」。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunTier)' != '' and !$([System.String]::Copy('|kernel|platform|').Contains('|$(KunTier)|'))"
           Text="$(MSBuildProjectName) 的 KunTier 是「$(KunTier)」，只能写 kernel 或 platform（区分大小写）。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunRole)' != '' and !$([System.String]::Copy('|contract|provider|').Contains('|$(KunRole)|'))"
           Text="$(MSBuildProjectName) 的 KunRole 是「$(KunRole)」，只能写 contract 或 provider（区分大小写）。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunZeroDependency)' != '' and !$([System.String]::Copy('|true|false|').Contains('|$(KunZeroDependency)|'))"
           Text="$(MSBuildProjectName) 的 KunZeroDependency 是「$(KunZeroDependency)」，只能写 true 或 false，或者不写。" />
  </Target>

  <!--
    公共 API（S1-KUN-020）。
    可打包的项目自动接 Microsoft.CodeAnalysis.PublicApiAnalyzers：公共 API 必须登记在项目目录的 PublicAPI.Shipped.txt 与
    PublicAPI.Unshipped.txt 里，新增未登记（RS0016）、登记了却已删除（RS0017）、缺登记文件（RS0048）等一律编译失败。
    这里单列 WarningsAsErrors，是为了项目即使关掉 TreatWarningsAsErrors 也绕不过去。两份文件缺一个报 QIAN0001；
    这个诊断号按合并蓝图 D23.10 在改名批次里随分析器的诊断号一起改。
  -->
  <PropertyGroup Label="公共 API" Condition="'$(IsPackable)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025;RS0026;RS0027;RS0036;RS0037;RS0041;RS0048;RS0050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Label="公共 API" Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <Target Name="KunRequirePublicApiFiles" BeforeTargets="CoreCompile" Condition="'$(IsPackable)' == 'true'">
    <Error Code="QIAN0001"
           Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') or !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="$(MSBuildProjectName) 可打包（IsPackable=true），项目目录下必须有 PublicAPI.Shipped.txt 与 PublicAPI.Unshipped.txt，首行写 #nullable enable。做法见仓库根 AGENTS.md「项目文件与包」。" />
  </Target>

</Project>
