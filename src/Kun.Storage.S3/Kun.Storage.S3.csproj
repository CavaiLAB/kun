<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      IsAotCompatible is not set: AWSSDK.S3 uses runtime reflection for request/response
      marshalling that is not trim- or AOT-safe. This module is therefore the first
      non-AOT library module in the Kun repository (see open-questions.md A6). It is
      not in the AOT smoke host (tests/Kun.AotSmoke). See AGENTS.md for rationale and
      a future-work note on migrating to a native HTTP signing client if AOT becomes a
      requirement.
    -->
    <IsPackable>true</IsPackable>
    <Description>Kun Framework — Amazon S3 / S3-compatible (MinIO) IFileStorage implementation. Forces Content-Disposition: attachment on presigned download URLs for active-web content types (text/html, image/svg+xml, application/xhtml+xml, application/xml). Not AOT-compatible.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.Storage.Abstractions\Kun.Storage.Abstractions.csproj" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
