    <ProjectReference Include="../../../../src/Kun.Tenancy.Signup/Kun.Tenancy.Signup.csproj" />
    <ProjectReference Include="../../packages/Qian.Audit.Native/Qian.Audit.Native.csproj" />
    <ProjectReference Include="../../../../src/Kun.Security/Kun.Security.csproj" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <!-- 同进程形状的集成测试直接驱动迁移 Job 与引导 Job 的入口（PlatformMigrations / PlatformOperatorBootstrap）。 -->
    <InternalsVisibleTo Include="Qian.Sample.Crm.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="platform.overlay.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="identity.overlay.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
