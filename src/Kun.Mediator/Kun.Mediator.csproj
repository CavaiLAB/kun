<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>High-performance, reflection-free CQRS dispatcher for Kun Framework. AOT-native alternative to MediatR.</Description>
  </PropertyGroup>

  <!-- 记契约：组件建在它上面（组件运行时 Qian.Runtime 依赖它），与 Kun.Core 同理，旧门禁对运行时与 SDK 一律放行（S1-KUN-020，B3 PR-4 归类）。 -->
  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>contract</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kun.Authorization/Kun.Authorization.csproj" />
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
