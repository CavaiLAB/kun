<Project>

  <!--
    仓库的构建守卫与门禁，仓库根与 _import/qian/ 下的项目共用（S1-KUN-020）。_import/qian/Directory.Build.targets 先导入本文件。
    依次是：档位声明、公共 API、AOT、禁用符号与平台分析器的作用域。
  -->

  <!--
    档位声明（S1-KUN-020；合并蓝图 D23.7、D23.14 第 1 点）。
    可打包的项目必须在项目文件里写档位与角色，依赖门禁 scripts/check_deps.py 按它们检查依赖，不看包名：

      KunTier            kernel（内核档）或 platform（平台档）
      KunRole            contract（契约）或 provider（提供者）
      KunZeroDependency  写 true 的包不得有项目引用，包引用只许 Microsoft.Extensions.*；不写即 false

    依赖规则的例外写成 KunTierException 项，同样在项目文件里，写法见 scripts/check_deps.py。
    这里只查写没写、取值对不对，区分大小写：没写 KunTier 或 KunRole 报 KUNTIER001，取值不对报 KUNTIER002。
    不打包的项目（测试、工具、宿主、样例）不记档位。
  -->
  <Target Name="KunRequireTierDeclaration" BeforeTargets="CoreCompile" Condition="'$(IsPackable)' == 'true'">
    <Error Code="KUNTIER001"
           Condition="'$(KunTier)' == '' or '$(KunRole)' == ''"
           Text="$(MSBuildProjectName) 可打包，项目文件里必须写档位 KunTier（kernel 或 platform）与角色 KunRole（contract 或 provider）。做法见仓库根 AGENTS.md「档位与依赖」。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunTier)' != '' and !$([System.String]::Copy('|kernel|platform|').Contains('|$(KunTier)|'))"
           Text="$(MSBuildProjectName) 的 KunTier 是「$(KunTier)」，只能写 kernel 或 platform（区分大小写）。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunRole)' != '' and !$([System.String]::Copy('|contract|provider|').Contains('|$(KunRole)|'))"
           Text="$(MSBuildProjectName) 的 KunRole 是「$(KunRole)」，只能写 contract 或 provider（区分大小写）。" />
    <Error Code="KUNTIER002"
           Condition="'$(KunZeroDependency)' != '' and !$([System.String]::Copy('|true|false|').Contains('|$(KunZeroDependency)|'))"
           Text="$(MSBuildProjectName) 的 KunZeroDependency 是「$(KunZeroDependency)」，只能写 true 或 false，或者不写。" />
  </Target>

  <!-- NuGet 用版本下限打包普通项目引用。可访问内部成员的包需要与被引用程序集保持同一版本。 -->
  <Target Name="KunGetFriendPackReference" Returns="@(_KunFriendPackReference)">
    <ItemGroup>
      <_KunConsumingFriend Include="@(InternalsVisibleTo)"
                           Condition="'%(InternalsVisibleTo.Identity)' == '$(KunConsumingAssembly)'" />
      <_KunFriendPackReference Include="$(MSBuildProjectFullPath)" ProjectVersion="[$(PackageVersion)]"
                               Condition="'@(_KunConsumingFriend)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="KunPinFriendPackReferences" AfterTargets="_GetProjectReferenceVersions"
          Condition="'@(_ProjectReferencesWithVersions)' != ''">
    <MSBuild Projects="@(_ProjectReferencesWithVersions)" Targets="KunGetFriendPackReference"
             Properties="KunConsumingAssembly=$(AssemblyName)" SkipNonexistentTargets="true" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_KunPinnedReferences" />
    </MSBuild>
    <ItemGroup>
      <_ProjectReferencesWithVersions Remove="@(_KunPinnedReferences)" />
      <_ProjectReferencesWithVersions Include="@(_KunPinnedReferences)" />
    </ItemGroup>
  </Target>

  <!--
    公共 API（S1-KUN-020）。
    可打包的项目自动接 Microsoft.CodeAnalysis.PublicApiAnalyzers：公共 API 必须登记在项目目录的 PublicAPI.Shipped.txt 与
    PublicAPI.Unshipped.txt 里，新增未登记（RS0016）、登记了却已删除（RS0017）、缺登记文件（RS0048）等一律编译失败。
    这里单列 WarningsAsErrors，是为了项目即使关掉 TreatWarningsAsErrors 也绕不过去。两份文件缺一个报 KUNAPI001；
    这个诊断号按合并蓝图 D23.10 在改名批次里随分析器的诊断号一起改。
  -->
  <PropertyGroup Label="公共 API" Condition="'$(IsPackable)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025;RS0026;RS0027;RS0036;RS0037;RS0041;RS0048;RS0050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Label="公共 API" Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <Target Name="KunRequirePublicApiFiles" BeforeTargets="CoreCompile" Condition="'$(IsPackable)' == 'true'">
    <Error Code="KUNAPI001"
           Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') or !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="$(MSBuildProjectName) 可打包（IsPackable=true），项目目录下必须有 PublicAPI.Shipped.txt 与 PublicAPI.Unshipped.txt，首行写 #nullable enable。做法见仓库根 AGENTS.md「项目文件与包」。" />
  </Target>

  <!--
    AOT（S1-KUN-020）。
    AOT 兼容的库在项目文件里写 <IsAotCompatible>true</IsAotCompatible>，这些项目就是清单，没有别的副本：
    scripts/aot_projects.py 列出它们；tests/Kun.AotSmoke 引用其中每一个并整体扎根，CI 原生发布后运行它；
    门禁自测核对它的项目引用正好等于清单。下面三种情况构建报错：

      KUNAOT001  还写着 IsAotCandidate：这个开关已经不用，写了也不生效
      KUNAOT002  可打包的库在项目文件里写了 PublishAot（命令行上给的与同名环境变量都不算，见仓库根 Directory.Build.props）
      KUNAOT003  写了 IsAotCompatible=true，却关掉了 IsTrimmable 或裁剪、AOT、单文件分析器
  -->
  <Target Name="KunAotGuard" BeforeTargets="CoreCompile">
    <Error Code="KUNAOT001"
           Condition="'$(IsAotCandidate)' != ''"
           Text="$(MSBuildProjectName) 还写着 IsAotCandidate。这个开关已经不用：AOT 兼容的库在项目文件里写 IsAotCompatible=true，不兼容的什么都不写。" />
    <Error Code="KUNAOT002"
           Condition="'$(IsPackable)' == 'true' and '$(PublishAot)' == 'true' and '$(_KunPublishAotFromCommandLine)' != 'true'"
           Text="$(MSBuildProjectName) 可打包，项目文件里不能写 PublishAot：它是原生发布可执行项目的开关，只写在那样的项目里。库兼容 AOT 就写 IsAotCompatible=true。" />
    <Error Code="KUNAOT003"
           Condition="'$(IsAotCompatible)' == 'true' and ('$(IsTrimmable)' == 'false' or '$(EnableTrimAnalyzer)' == 'false' or '$(EnableAotAnalyzer)' == 'false' or '$(EnableSingleFileAnalyzer)' == 'false')"
           Text="$(MSBuildProjectName) 写了 IsAotCompatible=true，就不能关掉 IsTrimmable 或裁剪、AOT、单文件分析器。不兼容 AOT 就去掉 IsAotCompatible。" />
  </Target>

  <!--
    禁用符号与平台分析器的作用域（S1-KUN-020；合并蓝图 D23.14 第 4 点）。
    仓库根的 BannedSymbols.txt（Microsoft.CodeAnalysis.BannedApiAnalyzers，RS0030）与 _import/qian/tools/Qian.Build.Analyzers
    （KUNLEGACY002–KUNEVENT001）只接下面三类项目，诊断号不变：

      - 平台档的包（KunTier=platform）；
      - 宿主：项目文件里写了 <KunHost>true</KunHost> 的可执行项目；
      - 过渡期：_import/qian/ 下的全部项目，内核档的包也在内。那里的包不定义被禁的类型，接着零命中，却够得着被禁的入口
        与规则管的写法（如令牌透传、IgnoreQueryFilters），所以全部受检；各域批次把包搬出过渡目录时再按归属收窄。

    仓库根上除了平台档的包与宿主都不接：被禁的类型就定义在 src/ 下；搬出过渡目录的平台档包照旧接入。
    Kun 旧类型上的 Obsolete 诊断号（如 KUNS2S001）在哪里都随 TreatWarningsAsErrors 报错；
    接了分析器的项目另把 KUNS2S001 单列为错误。
  -->
  <PropertyGroup Label="分析器作用域">
    <_KunTransitionalDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '_import', 'qian'))</_KunTransitionalDirectory>
    <_KunProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_KunProjectDirectory>
    <_KunPlatformAnalyzers>false</_KunPlatformAnalyzers>
    <_KunPlatformAnalyzers Condition="'$(KunTier)' == 'platform' or '$(KunHost)' == 'true'">true</_KunPlatformAnalyzers>
    <_KunPlatformAnalyzers Condition="$(_KunProjectDirectory.StartsWith('$(_KunTransitionalDirectory)'))">true</_KunPlatformAnalyzers>
  </PropertyGroup>

  <ItemGroup Label="分析器作用域" Condition="'$(_KunPlatformAnalyzers)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Label="分析器作用域" Condition="'$(_KunPlatformAnalyzers)' == 'true' and '$(MSBuildProjectName)' != 'Kun.Build.Analyzers'">
    <CompilerVisibleProperty Include="IsTestProject" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)tools/Kun.Build.Analyzers/Kun.Build.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup Label="分析器作用域" Condition="'$(_KunPlatformAnalyzers)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030;KUNLEGACY002;KUNDATA001;KUNDATA002;KUNAUTHZ001;KUNEVENT001;KUNS2S001</WarningsAsErrors>
  </PropertyGroup>

</Project>
