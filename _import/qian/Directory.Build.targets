<Project>

  <!--
    仓库根的 Directory.Build.targets（S1-KUN-020）：档位声明、公共 API 门禁、AOT 守卫，以及禁用符号与平台分析器的作用域，都不看包名。
    前三项按 IsPackable 与项目里写的 AOT 开关判定，对仓库根与本目录下的项目一视同仁；分析器作用域按档位与 KunHost 判定，
    过渡期另把本目录下的项目全部接入，见那里的注释。
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Qian 包的判定：IsPackable=true 且包名以 Qian. 开头。
    QianIsPackage / QianPackageId 只给 scripts/dotnet_release.py 读（dotnet msbuild -getProperty），改名要两边一起改。
    门禁都不用这两个属性：公共 API 门禁按 IsPackable，依赖门禁按项目文件里写的档位（仓库根的 scripts/check_deps.py）。
    PackageId 的 SDK 默认值在本文件之后才赋，这里按 PackageId → AssemblyName → 项目名依次兜底。
  -->
  <PropertyGroup Label="Qian package">
    <QianPackageId>$(PackageId)</QianPackageId>
    <QianPackageId Condition="'$(QianPackageId)' == ''">$(AssemblyName)</QianPackageId>
    <QianPackageId Condition="'$(QianPackageId)' == ''">$(MSBuildProjectName)</QianPackageId>
    <QianIsPackage Condition="'$(IsPackable)' == 'true' and $(QianPackageId.StartsWith('Qian.'))">true</QianIsPackage>
    <QianIsPackage Condition="'$(QianIsPackage)' == ''">false</QianIsPackage>
  </PropertyGroup>

</Project>
