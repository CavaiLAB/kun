<Project>

  <!--
    全仓 .NET 项目的目标框架、质量门槛与确定性构建设置。
    src/Directory.Build.props 为可打包项目设置版本、元数据与 README。
  -->

  <PropertyGroup Label="Targeting">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 缺 XML 注释只告警不阻断。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- 带后缀的 AnalysisLevel 同时决定分析模式；不再另写 AnalysisMode（写了也会被它盖过）。 -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- 包漏洞审计覆盖直接与传递依赖；命中即随 TreatWarningsAsErrors 让还原失败。 -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!--
    AOT 由各项目文件自己声明（S1-KUN-020）：AOT 兼容的库写 <IsAotCompatible>true</IsAotCompatible>，SDK 在项目文件之后
    据此打开 IsTrimmable 与裁剪、AOT、单文件三个分析器；不兼容的不写。PublishAot 只写在要原生发布的可执行项目里。
    守卫与清单见仓库根的 Directory.Build.targets。
    这里记下此时已有的 PublishAot，守卫把它当成命令行上给的放行，只拦在这之后才写成 true 的（项目文件里写的，
    或子目录的 Directory.Build.props 在导入本文件之后写的）。
    此时读到的有两种来处：全局属性（命令行上的 -p:PublishAot=true、上层项目经 MSBuild 任务传下来的），在求值开始前就定了；
    同名的环境变量，MSBuild 也当属性读。MSBuild 不记属性的来处，所以设了环境变量 PublishAot=true 时，库的项目文件里再写
    PublishAot=true，值没有变化，守卫看不出来。仓库里的脚本、测试与 CI 都只在命令行上给 PublishAot。
  -->
  <PropertyGroup Label="AOT">
    <_KunPublishAotFromCommandLine>$(PublishAot)</_KunPublishAotFromCommandLine>
  </PropertyGroup>

  <PropertyGroup Label="Deterministic Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
