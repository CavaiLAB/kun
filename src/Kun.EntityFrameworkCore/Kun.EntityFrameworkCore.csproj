<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>EF Core 10 write-side persistence for Kun Framework: KunDbContext, atomic Outbox integration, tenant filters.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>contract</KunRole>
  </PropertyGroup>

  <ItemGroup Label="档位例外">
    <KunTierException Include="Kun.EventBus" Rule="D" Until="B6" Reason="严格基类与数据会话契约用到的 Outbox 写入端（IOutboxWriter、IntegrationEventBuffer、OutboxMessage）还在 Kun.EventBus；B6 把 Outbox 写入契约挪进 Kun.EventBus.Abstractions 时去掉" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.Runtime\Kun.Runtime.csproj" />
    <ProjectReference Include="..\Kun.Errors\Kun.Errors.csproj" />
    <ProjectReference Include="..\Kun.EventBus\Kun.EventBus.csproj" />
    <ProjectReference Include="..\Kun.Mediator\Kun.Mediator.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
