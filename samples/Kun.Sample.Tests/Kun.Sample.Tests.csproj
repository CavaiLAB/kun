<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testcontainers 4.0 transitively requests vulnerable SSH.NET 2023; retain the audit gate. -->
    <PackageReference Include="SSH.NET" PrivateAssets="all" />
    <!--
      Both sample services expose a top-level Program class (global namespace).
      We alias each assembly so that test files can use:
        extern alias CatalogApp;
        extern alias OrderApp;
      to unambiguously reference each Program type with WebApplicationFactory<T>.
    -->
    <ProjectReference Include="..\Kun.Sample.Catalog\Kun.Sample.Catalog.csproj" Aliases="CatalogApp" />
    <ProjectReference Include="..\Kun.Sample.Order\Kun.Sample.Order.csproj" Aliases="OrderApp" />
    <PackageReference Include="xunit.v3" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.x 要求 Microsoft.OpenApi [2.12.0, 3.0.0)；中央版本是 _import/qian/ 下的项目用的 3.x，这里留在 2.x（S1-KUN-020）。 -->
    <PackageReference Include="Microsoft.OpenApi" VersionOverride="2.13.1" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
</Project>
