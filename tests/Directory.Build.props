<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup Label="Test Project Overrides">
    <!-- Test methods do not need XML docs; suppress CS1591 under tests/.
         Keep GenerateDocumentationFile=true (inherited) so IDE0005 still works. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Tests are never packaged or published. -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!--
    CI 的测试分片 k 让每个测试模块按项目名写 TRX 与覆盖率（S1-KUN-020）。dotnet test 同时启动几个模块，
    TRX 的缺省文件名只有「用户_机器_时间戳」，覆盖率的缺省文件名只有毫秒时间戳，同名时后写完的覆盖先写完的。
    -p:QianTrxPerModule=true 与 _import/qian/tests/Directory.Build.props 里的同名开关一样；-p:CoveragePerModule=true
    给覆盖率文件加项目名前缀，要和 coverlet 一起给，CI 核对份数后再去掉文件名里的时间戳
    （_import/qian/scripts/dotnet_ci.py coverage）。两个都默认不开：本机运行与 dotnet run 照旧。
  -->
  <PropertyGroup Label="Per-module TRX" Condition="'$(QianTrxPerModule)' == 'true'">
    <RunArguments>$(RunArguments) --report-xunit-trx-filename $(MSBuildProjectName).trx</RunArguments>
  </PropertyGroup>
  <PropertyGroup Label="Per-module coverage" Condition="'$(CoveragePerModule)' == 'true'">
    <RunArguments>$(RunArguments) --coverlet-file-prefix $(MSBuildProjectName)</RunArguments>
  </PropertyGroup>

</Project>
