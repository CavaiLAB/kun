<Project>

  <!--
    中央包版本只有仓库根上那一份（S1-KUN-020），这里只导入它。
    原 Qian 已改为项目引用 Kun 源码，不再按包引用 Kun，本文件也就不再有 Kun.* 的版本条目。
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    过渡用的 KunVersion，任何构建都不读它。读它的只有：文档站（「Kun 框架」小节、Kun API 参考、版本矩阵，
    website/scripts/kun.ts 等）、根上的 qian-docs-site 工作流与 scripts/check_docs.py。
    tests/gates/test_build_merge.py 保证没有 csproj、props 或 targets 引用 $(KunVersion)。
    文档站改读别处之后删除本属性，由计划会话在 B3 之后另排。
  -->
  <PropertyGroup Label="Kun">
    <KunVersion>2026.10.25</KunVersion>
  </PropertyGroup>

</Project>
