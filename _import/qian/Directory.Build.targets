<Project>

  <!-- 仓库根的 Directory.Build.targets：可打包项目的档位声明检查（S1-KUN-020）。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Qian 包的判定：IsPackable=true 且包名以 Qian. 开头。
    QianIsPackage / QianPackageId 也是 scripts/dotnet_release.py 读取的属性（dotnet msbuild -getProperty），改名要两边一起改。
    依赖门禁不用这两个属性，按项目文件里写的档位检查，见仓库根的 scripts/check_deps.py。
    PackageId 的 SDK 默认值在本文件之后才赋，这里按 PackageId → AssemblyName → 项目名依次兜底。
  -->
  <PropertyGroup Label="Qian package">
    <QianPackageId>$(PackageId)</QianPackageId>
    <QianPackageId Condition="'$(QianPackageId)' == ''">$(AssemblyName)</QianPackageId>
    <QianPackageId Condition="'$(QianPackageId)' == ''">$(MSBuildProjectName)</QianPackageId>
    <QianIsPackage Condition="'$(IsPackable)' == 'true' and $(QianPackageId.StartsWith('Qian.'))">true</QianIsPackage>
    <QianIsPackage Condition="'$(QianIsPackage)' == ''">false</QianIsPackage>
  </PropertyGroup>

  <!--
    门禁：PublicAPI（PRD §14.4 C1、specs/component-model.md §10.3 G4、ADR-019 D19.7）。
    全部 Qian 包自动挂 Microsoft.CodeAnalysis.PublicApiAnalyzers：公共 API 必须登记在 PublicAPI.Shipped.txt /
    PublicAPI.Unshipped.txt，新增未登记（RS0016）、登记了却已删除（RS0017）、缺登记文件（RS0048）等一律编译失败。
    这里单列 WarningsAsErrors，是为了项目即使关掉 TreatWarningsAsErrors 也绕不过去。
  -->
  <PropertyGroup Label="PublicAPI gate" Condition="'$(QianIsPackage)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025;RS0026;RS0027;RS0036;RS0037;RS0041;RS0048;RS0050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Label="PublicAPI gate" Condition="'$(QianIsPackage)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')" />
  </ItemGroup>

  <Target Name="QianRequirePublicApiFiles" BeforeTargets="CoreCompile" Condition="'$(QianIsPackage)' == 'true'">
    <Error Code="QIAN0001"
           Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') or !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="$(QianPackageId) 是 Qian 包（IsPackable=true），项目目录下必须有 PublicAPI.Shipped.txt 与 PublicAPI.Unshipped.txt，首行写 #nullable enable。做法见 tests/README.md「门禁」一节。" />
  </Target>

  <!-- 旧 Kun 入口在全部代码树（含宿主与测试）禁用，避免换包名或关闭打包绕过。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Qian.Build.Analyzers'">
    <CompilerVisibleProperty Include="IsTestProject" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)tools/Qian.Build.Analyzers/Qian.Build.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030;QIAN0002;QIAN0003;QIAN0004;QIAN0005;QIAN0006;KUNS2S001</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Kun.Gateway 只当库引用（S1-KUN-020）。
    Kun.Gateway 既是 NuGet 库，也是独立宿主（Web SDK、OutputType=Exe）。原 Qian 改为项目引用 Kun 源码之后，SDK 会把它作为
    宿主的文件交给引用方：appsettings.json、启动器（apphost）、Kun.Gateway.deps.json、Kun.Gateway.runtimeconfig.json、
    Kun.Gateway.staticwebassets.endpoints.json，经直接或传递的项目引用复制进引用方的输出目录与发布目录。引用方自己没有
    appsettings.json 时，输出目录里就是 Kun.Gateway 的那份，从输出目录读配置的测试宿主、开发宿主会读到它。
    按包引用时这些文件都不会进来：包里的 appsettings.json 是 copyToOutput=false 的 contentFiles，其余几个包里没有。

    引用方要的只是程序集，程序集和它的 pdb、xml 走引用复制，不经下面这几份复制清单。所以凡来源在 Kun.Gateway 项目目录
    （含 bin/、obj/）下的复制项，这里一律去掉；本项目自己的复制在其后执行，读的是去掉以后的清单。
    MSBuild 在目标执行完时就定下了它的返回清单，AfterTargets 改不了交给上层引用方的那份，所以每个引用方各自过滤。
    原 Qian 里直接或传递引用 Kun.Gateway 的项目都在 _import/qian 下，都导入本文件；这些项目迁出 _import/qian 时，这段要跟着走。
    tests/Qian.Gateway.Tests 核对输出目录，仓库根 ci.yml 的生产网关作业（gateway-host-aot）核对发布目录。
  -->
  <PropertyGroup Label="Kun.Gateway as library">
    <QianKunGatewayDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'Kun.Gateway'))</QianKunGatewayDirectory>
  </PropertyGroup>

  <Target Name="QianDropKunGatewayHostFilesFromOutput" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                                                 Condition="$([System.String]::Copy('%(_SourceItemsToCopyToOutputDirectoryAlways.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)"
                                           Condition="$([System.String]::Copy('%(_SourceItemsToCopyToOutputDirectory.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_SourceItemsToCopyToOutputDirectoryIfDifferent)"
                                                      Condition="$([System.String]::Copy('%(_SourceItemsToCopyToOutputDirectoryIfDifferent.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
    </ItemGroup>
  </Target>

  <Target Name="QianDropKunGatewayHostFilesFromPublish" AfterTargets="GetCopyToPublishDirectoryItems">
    <ItemGroup>
      <_SourceItemsToCopyToPublishDirectoryAlways Remove="@(_SourceItemsToCopyToPublishDirectoryAlways)"
                                                  Condition="$([System.String]::Copy('%(_SourceItemsToCopyToPublishDirectoryAlways.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
      <_SourceItemsToCopyToPublishDirectory Remove="@(_SourceItemsToCopyToPublishDirectory)"
                                            Condition="$([System.String]::Copy('%(_SourceItemsToCopyToPublishDirectory.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
      <_SourceItemsToCopyToPublishDirectoryIfDifferent Remove="@(_SourceItemsToCopyToPublishDirectoryIfDifferent)"
                                                       Condition="$([System.String]::Copy('%(_SourceItemsToCopyToPublishDirectoryIfDifferent.FullPath)').StartsWith('$(QianKunGatewayDirectory)'))" />
    </ItemGroup>
  </Target>

</Project>
