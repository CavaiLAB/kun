<Project>

  <!--
    仓库的 .NET 构建基线，仓库根与 _import/qian/ 下的项目共用（S1-KUN-020）。
    这里只放两边都要的：目标框架、质量门槛、确定性构建。
    src/ 下 Kun 包的版本、包元数据与 README 打包在 src/Directory.Build.props，只对这些包生效；
    _import/qian/ 下的打包设置在 _import/qian/Directory.Build.props，它先导入本文件。
  -->

  <PropertyGroup Label="Targeting">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 缺 XML 注释只告警不阻断。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- 带后缀的 AnalysisLevel 同时决定分析模式；不再另写 AnalysisMode（写了也会被它盖过）。 -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- 包漏洞审计覆盖直接与传递依赖；命中即随 TreatWarningsAsErrors 让还原失败。 -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!--
    AOT 由各项目文件自己声明（S1-KUN-020）：AOT 兼容的库写 <IsAotCompatible>true</IsAotCompatible>，SDK 在项目文件之后
    据此打开 IsTrimmable 与裁剪、AOT、单文件三个分析器；不兼容的不写。PublishAot 只写在要原生发布的可执行项目里。
    守卫与清单见仓库根的 Directory.Build.targets。
    这里只记下命令行上给的 PublishAot（如 dotnet publish -p:PublishAot=true）：全局属性在求值开始前就定了，此时读到的
    只会是它，守卫据此只拦写在项目文件里的 PublishAot。
  -->
  <PropertyGroup Label="AOT">
    <_KunPublishAotFromCommandLine>$(PublishAot)</_KunPublishAotFromCommandLine>
  </PropertyGroup>

  <PropertyGroup Label="Deterministic Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
