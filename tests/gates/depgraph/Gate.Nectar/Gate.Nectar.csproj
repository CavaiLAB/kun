<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>门禁自测样例：（违规 C）零依赖的包引用了不是零依赖的项目，还有 Microsoft.Extensions.* 以外的包引用；引用零依赖的 Gate.Amber 不算违规</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>contract</KunRole>
    <KunZeroDependency>true</KunZeroDependency>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Gate.Amber/Gate.Amber.csproj" />
    <ProjectReference Include="../Gate.Umber/Gate.Umber.csproj" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

</Project>
