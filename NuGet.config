<?xml version="1.0" encoding="utf-8"?>
<!--
  只用仓库内声明的包源，不受本机全局 NuGet 配置影响，CI 与本地还原结果一致。由 _import/qian/NuGet.config 移来（S1-KUN-020）。
  _import/qian/ 下的项目改为项目引用 Kun 源码后，仓库里的项目不再从包源还原 Kun.*，原来单列的 Kun.* 映射去掉；
  文档站生成 Kun API 参考时仍从 nuget.org 还原同版本的 Kun.* 包，由下面的 * 映射覆盖。
  要用本地包源的两个消费者（Kun 网关包的 NativeAOT 消费者、_import/qian/ 下的包发版后的干净消费者）都在仓库外的临时目录里，
  用 dotnet restore / publish 的 configfile 参数指定自己的配置，不读本文件。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
