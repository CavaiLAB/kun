<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>Kun Framework sandbox client abstractions with portable create/process/file APIs, explicitly named provider extensions, an in-memory test backend, a configured supervisor client, and a future cloud-provider placeholder. Does not host a sandbox runtime.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kun.Sandbox.Tests" />
  </ItemGroup>

</Project>
