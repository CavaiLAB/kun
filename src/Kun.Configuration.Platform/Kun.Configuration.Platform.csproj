<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>true</IsPackable><Description>Apollo/标准配置 Provider、租户灰度求值、受限草稿编辑与发布审计。</Description>
    <!-- 启用裁剪与 AOT 静态分析；只读 Apollo 路径已由 GW-001 原生宿主验收，可选管理入口不因此自动获得原生发布证据。 -->
    <IsAotCompatible>true</IsAotCompatible></PropertyGroup>
  <PropertyGroup Label="档位">
    <KunTier>platform</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kun.Configuration/Kun.Configuration.csproj" />
    <ProjectReference Include="../Kun.Configuration.Abstractions/Kun.Configuration.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Data.Native.Abstractions/Kun.Data.Native.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Audit.Abstractions/Kun.Audit.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Authorization.Rbac.Abstractions/Kun.Authorization.Rbac.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Identity.Abstractions/Kun.Identity.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Configuration.Apollo/Kun.Configuration.Apollo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Kun.Plugin.Sdk/Kun.Plugin.Sdk.csproj" />
    <ProjectReference Include="../Kun.Plugin.Sdk.Generators/Kun.Plugin.Sdk.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
