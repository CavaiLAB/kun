<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>true</IsPackable><Description>Qian 组件的代码声明、生成契约与安全执行协议。</Description></PropertyGroup>
  <PropertyGroup Label="档位"><KunTier>kernel</KunTier><KunRole>provider</KunRole></PropertyGroup>
  <ItemGroup Label="档位例外">
    <KunTierException Include="Qian.Authz.Abstractions" Rule="K" Until="B4" Reason="B4 拆包时移进平台档的那一半；不拆就等 B8 授权一域归位" />
    <KunTierException Include="Qian.Data.Abstractions" Rule="K" Until="B4" Reason="命令管道用 QianDbContext 与 IDataSession；B4 拆出平台档的 Kun.Plugin.Sdk.Commands 时移过去，不拆就等 B5" />
    <KunTierException Include="Qian.Identity.Abstractions" Rule="K" Until="B4" Reason="用 Principal、ICurrentUser 等身份类型；B4 拆包时移进平台档的那一半，不拆就等 B7 Principal 下沉 Kun.Security" />
    <KunTierException Include="Qian.Surfaces.Abstractions" Rule="K" Until="B4" Reason="用钩子的 HookDefinition、IHookHandler；B4 拆包时移进平台档的那一半，不拆就等 B10 表面一域归位" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../src/Kun.Runtime/Kun.Runtime.csproj" /><ProjectReference Include="../Qian.Data.Abstractions/Qian.Data.Abstractions.csproj" /><ProjectReference Include="../Qian.Identity.Abstractions/Qian.Identity.Abstractions.csproj" /><ProjectReference Include="../Qian.Authz.Abstractions/Qian.Authz.Abstractions.csproj" /><ProjectReference Include="../Qian.Events.Abstractions/Qian.Events.Abstractions.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Qian.Surfaces.Abstractions/Qian.Surfaces.Abstractions.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" /></ItemGroup>
</Project>
