<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Qian 权限 seam、规范权限点与错误契约；复用 Kun.Authorization 端口。</Description>
  </PropertyGroup>
  <PropertyGroup Label="档位">
    <KunTier>platform</KunTier>
    <KunRole>contract</KunRole>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kun.Runtime/Kun.Runtime.csproj" />
    <ProjectReference Include="../../../../src/Kun.Authorization/Kun.Authorization.csproj" />
    <ProjectReference Include="../../../../src/Kun.Mediator/Kun.Mediator.csproj" />
    <ProjectReference Include="../../../../src/Kun.EventBus.Abstractions/Kun.EventBus.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Kun.Plugin.Sdk.Commands" /><InternalsVisibleTo Include="Kun.Tenancy" /><InternalsVisibleTo Include="Qian.Authz" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../contracts/data/v1/filter-ast.schema.json;../../contracts/data/v1/filter-operators.json;../../contracts/data/v1/system-variables.json" LogicalName="authz/%(Filename)%(Extension)" />
    <None Include="../../contracts/data/v1/filter-ast.schema.json;../../contracts/data/v1/filter-operators.json;../../contracts/data/v1/system-variables.json" Pack="true" PackagePath="contracts/data/v1/" />
    <EmbeddedResource Include="../../contracts/authz/v1/*.schema.json" LogicalName="authz/%(Filename)%(Extension)" />
    <None Include="../../contracts/authz/v1/*.schema.json" Pack="true" PackagePath="contracts/authz/v1/" />
  </ItemGroup>
</Project>
