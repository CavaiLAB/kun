<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>true</IsPackable><IsAotCompatible>true</IsAotCompatible><Description>以 Kun.Gateway 组合强制认证、Cookie 换 S2S、逐服务受众和热轮换的业务网关。</Description></PropertyGroup>
  <PropertyGroup Label="档位"><KunTier>kernel</KunTier><KunRole>provider</KunRole></PropertyGroup>
  <ItemGroup Label="档位例外">
    <KunTierException Include="Qian.Config.Abstractions" Rule="K" Until="B7" Reason="网关登记自己的 ConfigDefinition；B7 网关并入 Kun.Gateway 时去掉，最晚 B9 配置契约归位" />
    <KunTierException Include="Kun.Identity.Abstractions" Rule="K" Until="B7" Reason="网关用身份契约里的 Principal、Client、Session 等类型；B7 Principal 一组下沉 Kun.Security 后去掉" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Qian.Gateway.Abstractions/Qian.Gateway.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Kun.Identity.Abstractions/Kun.Identity.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Config.Abstractions/Qian.Config.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Kun.Errors.AspNetCore/Kun.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../../../../src/Kun.Plugin.Sdk/Kun.Plugin.Sdk.csproj" />
    <ProjectReference Include="../../../../src/Kun.Plugin.Sdk.Generators/Kun.Plugin.Sdk.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../src/Kun.Gateway/Kun.Gateway.csproj" />
    <PackageReference Include="StackExchange.Redis" />
    <InternalsVisibleTo Include="Qian.Gateway.Tests" />
  </ItemGroup>
</Project>
