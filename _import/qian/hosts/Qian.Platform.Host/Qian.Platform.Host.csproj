    <ProjectReference Include="../../../../src/Kun.Tenancy/Kun.Tenancy.csproj" />
    <ProjectReference Include="../../../../src/Kun.Tenancy.AspNetCore/Kun.Tenancy.AspNetCore.csproj" />
    <ProjectReference Include="../../../../src/Kun.Authorization.Rbac/Kun.Authorization.Rbac.csproj" />
    <ProjectReference Include="../../../../src/Kun.Authorization.AspNetCore/Kun.Authorization.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Audit/Qian.Audit.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Apollo/Qian.Config.Apollo.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Secrets/Qian.Config.Secrets.csproj" />
    <ProjectReference Include="../../packages/Qian.Registry/Qian.Registry.csproj" />
    <ProjectReference Include="../../packages/Qian.Capabilities/Qian.Capabilities.csproj" />
    <ProjectReference Include="../../packages/Qian.Capabilities.AspNetCore/Qian.Capabilities.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Lifecycle/Qian.Lifecycle.csproj" />
    <ProjectReference Include="../../packages/Qian.Profiles/Qian.Profiles.csproj" />
    <ProjectReference Include="../../packages/Qian.Surfaces/Qian.Surfaces.csproj" />
    <ProjectReference Include="../../../../src/Kun.Plugin.Sdk.AspNetCore/Kun.Plugin.Sdk.AspNetCore.csproj" />
    <ProjectReference Include="../../../../src/Kun.Errors.AspNetCore/Kun.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../../../../src/Kun.Identity.Abstractions/Kun.Identity.Abstractions.csproj" />
