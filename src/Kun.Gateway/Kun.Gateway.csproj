<Project Sdk="Microsoft.NET.Sdk">

  <!-- 网关的库。独立宿主在 hosts/Kun.Gateway.Standalone，自己写宿主的照那里的 Program.cs 组合。 -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>GATEWAY.md</PackageReadmeFile>
    <Description>Kun Framework — smart gateway library: external JWT to internal S2S JWT translation, YARP reverse proxy, rate limiting, JWKS endpoint.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <None Include="GATEWAY.md" Pack="true" PackagePath="/" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Kun.Gateway.Abstractions/Kun.Gateway.Abstractions.csproj" />
    <ProjectReference Include="../Kun.Errors.AspNetCore/Kun.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../Kun.RateLimit/Kun.RateLimit.csproj" />
    <InternalsVisibleTo Include="Kun.Gateway.IntegrationTests" />
    <InternalsVisibleTo Include="Kun.Gateway.Shell" />
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.Security\Kun.Security.csproj" />
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <!-- Web SDK 隐式带的 using 里库用到的几个；改成普通 SDK 之后不再隐式带，在这里补上，源码不动。 -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
