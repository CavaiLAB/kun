<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>true</IsPackable><Description>可嵌入的 OpenIddict 身份协议服务，含 Person / Membership 账号模型与统一登录流水线。</Description></PropertyGroup>
  <PropertyGroup Label="档位"><KunTier>platform</KunTier><KunRole>provider</KunRole></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../../src/Kun.Errors.AspNetCore/Kun.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../Qian.Identity.Abstractions/Qian.Identity.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Kun.Data.Abstractions/Kun.Data.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Events.Abstractions/Qian.Events.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Audit.Abstractions/Qian.Audit.Abstractions.csproj" />
    <ProjectReference Include="../../../../src/Kun.Tenancy.Abstractions/Kun.Tenancy.Abstractions.csproj" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <ProjectReference Include="../../../../src/Kun.Mediator/Kun.Mediator.csproj" />
    <!-- 会话中心的 Redis 索引（可选：宿主登记 IConnectionMultiplexer 才启用）。 -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Argon2id：纯托管实现，随 qian.lifecycle 已钉版；不引入本机库依赖。 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <InternalsVisibleTo Include="Qian.Identity.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kun.Plugin.Sdk/Kun.Plugin.Sdk.csproj" />
    <ProjectReference Include="../../../../src/Kun.Plugin.Sdk.Generators/Kun.Plugin.Sdk.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
