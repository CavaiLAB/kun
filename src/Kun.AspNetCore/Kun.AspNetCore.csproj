<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      IsAotCompatible is not set: ASP.NET Core minimal API helpers MapCommand<TCommand,TResponse>
      and MapQuery<TQuery,TResponse> use generic endpoint mapping (RDG011) and
      Delegate-based MapGet (IL2026/IL3050). Making the public API AOT-safe would require
      breaking changes (JsonTypeInfo<T> parameters on every helper). Until that work is
      scheduled, this module is trim-safe only.
      Error responses are not handled here: Kun.Errors.AspNetCore (AddKunErrors / UseKunErrors)
      is the only HTTP error mapping.
    -->
    <IsPackable>true</IsPackable>
    <Description>Kun Framework — ASP.NET Core integration: Minimal API endpoint mapping for commands and queries, permission policies.</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kun.Authorization/Kun.Authorization.csproj" />
    <ProjectReference Include="../Kun.Security/Kun.Security.csproj" />
    <ProjectReference Include="..\Kun.Core\Kun.Core.csproj" />
    <ProjectReference Include="..\Kun.Mediator\Kun.Mediator.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
