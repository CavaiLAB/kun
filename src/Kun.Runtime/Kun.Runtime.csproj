<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Qian 最小运行时：插件装载、服务键、事件与可逆副作用。</Description>
  </PropertyGroup>
  <!-- 记契约：组件建在它上面，与 Kun.Core 同理，旧门禁对运行时与 SDK 一律放行（S1-KUN-020，B3 PR-4 归类）。 -->
  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>contract</KunRole>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Kun.Core/Kun.Core.csproj" />
    <ProjectReference Include="../../../../src/Kun.Mediator/Kun.Mediator.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../../src/Kun.Errors/Kun.Errors.csproj" />
  </ItemGroup>
</Project>
