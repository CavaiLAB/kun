<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ErrorDetail 的 ASP.NET Core 映射（S1-AGT-001）：业务代码抛 ErrorException 或返回 KunResults.Error，
    框架自己产生的错误（未认证、404、请求体无法解析、未处理异常）经 ProblemDetails 管道规范成同一形状。
    Kun 的 HTTP 错误映射只有这一套：用 ASP.NET Core 自己的 IProblemDetailsService，不另起一套。
  -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Kun.Errors.AspNetCore</RootNamespace>
    <Description>Kun 结构化错误的 ASP.NET Core 映射：problem+json（ErrorDetail）输出、异常与状态码兜底、ProblemDetails 规范化。</Description>
  </PropertyGroup>

  <PropertyGroup Label="档位">
    <KunTier>kernel</KunTier>
    <KunRole>provider</KunRole>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kun.Errors/Kun.Errors.csproj" />
  </ItemGroup>

</Project>
